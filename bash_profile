#!/bin/bash

# starter .bash_profile for POLI
export LD_LIBRARY_PATH=/usr/local/lib:/usr/lib:/lib
export PATH=~/bin:/usr/local/bin:/usr/bin:/bin:/sbin

export POLI_HOME=~/poli
export POLI_USE_CACHE=YES
export POLI_URL=https://agrineer.org/publish

export PATH=$POLI_HOME/bin:$PATH
export PYTHONPATH=$POLI_HOME/frame:$POLI_HOME/operators



